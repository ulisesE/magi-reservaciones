rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // FUNCIONES AUXILIARES DE AUTORIZACIÓN Y ROLES (MAGI SECURITY ENGINE)
    // =========================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isStaffUser() {
      return isAuthenticated() && exists(/databases/$(database)/documents/piu_staff_users/$(request.auth.uid));
    }
    
    function getStaffDoc() {
      return get(/databases/$(database)/documents/piu_staff_users/$(request.auth.uid)).data;
    }
    
    // 👑 Superadministrador con privilegios globales en todas las sucursales
    function isSuperAdmin() {
      return isAuthenticated() && (
        (isStaffUser() && getStaffDoc().role == 'SUPERADMIN')
        || (request.auth.token.role == 'SUPERADMIN')
      );
    }
    
    // 🕹️ Encargado de sucursal con aislamiento estricto por businessId
    function isManagerForBusiness(bizId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (isStaffUser() && 
         getStaffDoc().role == 'MANAGER' && 
         (bizId != null && getStaffDoc().businessId == bizId))
      );
    }
    
    // 🎮 Jugador propietario del perfil / reservación
    function isOwnerPlayer(playerId) {
      return isAuthenticated() && (request.auth.uid == playerId);
    }

    // =========================================================================
    // 1. NEGOCIOS Y CONFIGURACIÓN MULTI-TENANT (piu_businesses, piu_system_settings)
    // =========================================================================
    match /piu_businesses/{businessId} {
      allow read: if true; // Directorio público de sucursales
      allow create, delete: if isSuperAdmin(); // Creación y borrado exclusivo de Superadmin
      allow update: if isManagerForBusiness(businessId); // Ajustes permitidos al Manager del local o Superadmin
    }

    match /piu_system_settings/{settingId} {
      allow read: if true; // Configuración global del sistema (ej: desactivar cambio de local)
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 2. MÁQUINAS, REGLAS OPERATIVAS Y CARACTERÍSTICAS (Aislamiento por Local)
    // =========================================================================
    match /piu_machines/{machineId} {
      allow read: if true;
      allow create: if isManagerForBusiness(request.resource.data.businessId);
      // Actualización y Transferencia permitida al Superadmin o al Encargado del local de origen
      allow update: if isSuperAdmin() || isManagerForBusiness(resource.data.businessId);
      allow delete: if isManagerForBusiness(resource.data.businessId);
    }
    
    match /piu_operating_rules/{ruleId} {
      allow read: if true;
      allow create: if isManagerForBusiness(request.resource.data.businessId);
      allow update: if isManagerForBusiness(resource.data.businessId) && request.resource.data.businessId == resource.data.businessId;
      allow delete: if isManagerForBusiness(resource.data.businessId);
    }
    
    match /piu_machine_features/{featureId} {
      allow read: if true;
      allow create: if isManagerForBusiness(request.resource.data.businessId);
      allow update: if isManagerForBusiness(resource.data.businessId) && request.resource.data.businessId == resource.data.businessId;
      allow delete: if isManagerForBusiness(resource.data.businessId);
    }

    // Catálogos Globales Maestros (Modelos de Gabinete y Versiones del Juego)
    match /piu_game_versions/{versionId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    
    match /piu_cabinet_models/{modelId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 3. CATÁLOGO DE PRODUCTOS Y PRECIOS POR SUCURSAL (piu_products)
    // =========================================================================
    match /piu_products/{productId} {
      allow read: if true;
      allow create: if isManagerForBusiness(request.resource.data.businessId) && request.resource.data.price >= 0;
      allow update: if isManagerForBusiness(resource.data.businessId) 
        && request.resource.data.businessId == resource.data.businessId 
        && request.resource.data.price >= 0;
      allow delete: if isManagerForBusiness(resource.data.businessId);
    }

    // =========================================================================
    // 4. PERSONAL Y ENCARGADOS (piu_staff_users) 🔥 BLINDAJE CON MIGRACIÓN TRANSPARENTE
    // =========================================================================
    match /piu_staff_users/{userId} {
      // Lectura pública de perfiles para autenticación y asignación de personal
      allow read: if true;
      
      // Creación: Superadmin o auto-migración/creación del propio documento de staff autenticado
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && (request.resource.data.email == request.auth.token.email || request.resource.data.email != null))
      );
      
      // Edición: Superadmin puede todo. Un Manager solo puede editar sus propios datos básicos sin alterar rol ni local
      allow update: if isSuperAdmin() || (
        isAuthenticated() &&
        (request.auth.uid == userId || (resource != null && resource.data.authUid == request.auth.uid)) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.businessId == resource.data.businessId
      );

      // Eliminación: Superadmin o limpieza del documento legacy propio
      allow delete: if isSuperAdmin() || (
        isAuthenticated() && resource != null && (resource.data.email == request.auth.token.email || resource.data.authUid == request.auth.uid)
      );
    }

    // =========================================================================
    // 5. JUGADORES Y DIRECTORIO GLOBAL (piu_players) 🛡️ DIRECTORIO GLOBAL CON PROTECCIÓN FINANCIERA
    // =========================================================================
    match /piu_players/{playerId} {
      // Directorio global de jugadores para inicio de sesión, autoservicio y búsqueda en mostrador
      allow read: if true;
      
      // Creación: Auto-registro seguro o migración de perfil
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        isStaffUser() ||
        (request.auth.uid == playerId) ||
        (
          request.resource.data.role == 'CLIENT' &&
          (request.resource.data.loyaltyPoints == 0 || request.resource.data.loyaltyPoints == null) &&
          (request.resource.data.loyalty == {} || request.resource.data.loyalty == null) &&
          (request.resource.data.accounts == {} || request.resource.data.accounts == null)
        )
      );
      
      // Actualización conceptual de tres niveles con soporte para perfiles migrados
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          (isOwnerPlayer(playerId) || (resource != null && resource.data.authUid == request.auth.uid)) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accounts', 'loyalty', 'loyaltyPoints', 'role', 'balance'])
        ) ||
        (
          isStaffUser() &&
          getStaffDoc().role == 'MANAGER' &&
          getStaffDoc().businessId != null &&
          request.resource.data.role == resource.data.role &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accounts']) ||
            request.resource.data.accounts.diff(resource.data.accounts).affectedKeys().hasOnly([getStaffDoc().businessId])
          ) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['loyalty']) ||
            request.resource.data.loyalty.diff(resource.data.loyalty).affectedKeys().hasOnly([getStaffDoc().businessId])
          )
        )
      );
      
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 6. RESERVACIONES (piu_reservations) 🔒 PRIVACIDAD, FINANZAS Y SOPORTE GUEST
    // =========================================================================
    match /piu_reservations/{reservationId} {
      // Lectura pública para visualización de disponibilidad de slots en el calendario (Día / Semana / Mes)
      allow read: if true;
      
      // Creación:
      // A. Manager/Staff del local (puede crear en CONFIRMED o PENDING)
      // B. Jugador registrado autenticado (solo PENDING, con clientId == request.auth.uid)
      // C. Invitado / Guest público (sin login, estrictamente PENDING y con esquema validado)
      allow create: if 
        (isAuthenticated() && isManagerForBusiness(request.resource.data.businessId) && request.resource.data.totalCost >= 0)
        ||
        (
          isAuthenticated() &&
          (isOwnerPlayer(request.resource.data.clientId) || isOwnerPlayer(request.resource.data.playerId)) && 
          request.resource.data.status == 'PENDING' &&
          request.resource.data.totalCost >= 0 &&
          request.resource.data.businessId is string &&
          request.resource.data.machineId is string &&
          request.resource.data.date is string &&
          request.resource.data.startTime is string &&
          request.resource.data.endTime is string
        )
        ||
        (
          // 👤 INVITADO PÚBLICO (GUEST): Reservación segura sin cuenta (estrictamente PENDING)
          request.auth == null &&
          request.resource.data.status == 'PENDING' &&
          (request.resource.data.clientId == null || request.resource.data.clientId == '') &&
          (request.resource.data.clientUsername == null || request.resource.data.clientUsername == '') &&
          request.resource.data.clientName is string && request.resource.data.clientName.size() >= 2 &&
          request.resource.data.businessId is string && request.resource.data.businessId.size() > 0 &&
          request.resource.data.machineId is string && request.resource.data.machineId.size() > 0 &&
          request.resource.data.date is string &&
          request.resource.data.startTime is string &&
          request.resource.data.endTime is string &&
          request.resource.data.totalCost is number && request.resource.data.totalCost >= 0
        );
      
      // Actualización: Manager de la sucursal o el jugador cancelando su propia reserva pendiente
      allow update: if isAuthenticated() && (
        (
          isManagerForBusiness(resource.data.businessId) && 
          request.resource.data.businessId == resource.data.businessId &&
          request.resource.data.totalCost >= 0
        ) ||
        (
          (isOwnerPlayer(resource.data.clientId) || isOwnerPlayer(resource.data.playerId)) && 
          request.resource.data.status == 'CANCELLED' && 
          resource.data.status == 'PENDING' &&
          request.resource.data.businessId == resource.data.businessId &&
          request.resource.data.totalCost == resource.data.totalCost
        )
      );
      
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 6b. CALENDARIOS Y BLOQUEO DE SLOTS (piu_machine_schedules) 🔒 EXCLUSIVO STAFF
    // =========================================================================
    match /piu_machine_schedules/{scheduleId} {
      // Lectura pública para visualización de disponibilidad (Día / Semana / Mes)
      allow read: if true;
      
      // 🛡️ ESCRITURA ESTRICTA: Solo Superadmin o Personal/Manager de la sucursal respectiva
      allow write: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.resource.data.businessId != null && isManagerForBusiness(request.resource.data.businessId)) ||
        (isStaffUser() && getStaffDoc().businessId == request.resource.data.businessId)
      );
    }

    // =========================================================================
    // 7. OPERACIONES MONETARIAS Y CONSUMOS (piu_consumptions) 💰
    // REGLAS FINANCIERAS: CERO BORRADO, AISLAMIENTO POR LOCAL E INMUTABILIDAD
    // =========================================================================
    match /piu_consumptions/{consumptionId} {
      // Lectura: Manager de la sucursal o el jugador que realizó el consumo
      allow read: if isAuthenticated() && (
        isManagerForBusiness(resource.data.businessId) ||
        isOwnerPlayer(resource.data.playerId)
      );
      
      // Creación: Únicamente el Manager asignado a la sucursal con montos válidos
      allow create: if isAuthenticated() && 
        isManagerForBusiness(request.resource.data.businessId) &&
        request.resource.data.totalAmount >= 0 &&
        request.resource.data.status in ['ACTIVE', 'PENDING', 'PAID'];
      
      // Actualización: Solo Manager de la sucursal. PROHIBIDO alterar negocio, jugador, importe histórico o eliminar motivo de anulación
      allow update: if isAuthenticated() &&
        isManagerForBusiness(resource.data.businessId) &&
        request.resource.data.businessId == resource.data.businessId &&
        request.resource.data.totalAmount == resource.data.totalAmount &&
        request.resource.data.playerId == resource.data.playerId &&
        request.resource.data.status in ['ACTIVE', 'VOIDED', 'CANCELLED', 'PAID'] &&
        (request.resource.data.status == 'VOIDED' ? request.resource.data.voidReason != null : true);
      
      // 🚫 INMUTABILIDAD FINANCIERA: Prohibido estrictamente borrar ventas o abonos
      allow delete: if false;
    }

    // =========================================================================
    // 8. PROGRAMA DE LEALTAD Y RECOMPENSAS (piu_loyalty_rewards, piu_redemptions)
    // =========================================================================
    match /piu_loyalty_rewards/{rewardId} {
      allow read: if true;
      allow create: if isManagerForBusiness(request.resource.data.businessId);
      allow update: if isManagerForBusiness(resource.data.businessId) && request.resource.data.businessId == resource.data.businessId;
      allow delete: if isManagerForBusiness(resource.data.businessId);
    }

    match /piu_redemptions/{redemptionId} {
      allow read: if isAuthenticated() && (
        isManagerForBusiness(resource.data.businessId) ||
        isOwnerPlayer(resource.data.playerId)
      );
      // Solo el Manager autorizado de la sucursal puede procesar canjes de premios en mostrador
      allow create: if isAuthenticated() && (
        isManagerForBusiness(request.resource.data.businessId)
      );
      allow update: if isManagerForBusiness(resource.data.businessId) && request.resource.data.businessId == resource.data.businessId;
      allow delete: if false; // Los canjes de recompensas son inmutables
    }

    // =========================================================================
    // 9. AUDITORÍA OBLIGATORIA (piu_audit_logs) 🛡️ VALIDACIÓN DE ESQUEMA E INMUTABILIDAD
    // =========================================================================
    match /piu_audit_logs/{logId} {
      // Lectura: Superadmin global o Manager de su respectiva sucursal
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        (isStaffUser() && getStaffDoc().businessId == resource.data.businessId)
      );
      
      // Creación: Solo Manager de la sucursal correspondiente o Superadmin, con actor vinculado al usuario autenticado (request.auth.uid)
      allow create: if isAuthenticated() && (
        isManagerForBusiness(request.resource.data.businessId) &&
        request.resource.data.action in [
          'SALE_RECORDED', 'PAYMENT_RECORDED', 'DEBT_LIQUIDATED', 'TRANSACTION_VOIDED',
          'POINTS_ADJUSTED', 'REWARD_REDEEMED', 'PRODUCT_CREATED', 'PRODUCT_UPDATED',
          'PRODUCT_DELETED', 'PRICE_CHANGED', 'STAFF_LOGIN', 'STAFF_LOGOUT',
          'STAFF_CREATED', 'STAFF_UPDATED', 'STAFF_DELETED', 'CLIENT_LOGIN', 'CLIENT_LOGOUT',
          'MACHINE_CREATED', 'MACHINE_UPDATED', 'MACHINE_DELETED',
          'RESERVATION_CREATED', 'RESERVATION_CLOSED', 'RESERVATION_MODIFIED', 'RESERVATION_CANCELLED',
          'BUSINESS_SETTINGS_UPDATED'
        ] &&
        request.resource.data.actor.id != null &&
        (request.resource.data.actor.id == request.auth.uid || isSuperAdmin()) &&
        request.resource.data.createdAt != null
      );
      
      // 🔒 INMUTABILIDAD TOTAL: Nadie puede editar ni borrar un registro de auditoría
      allow update, delete: if false;
    }
  }
}
